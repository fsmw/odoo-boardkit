<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="boardkit_dashboard.ItemCard">
        <div
            class="o_boardkit_dashboard_card d-flex flex-column h-100"
            t-att-style="cardStyle"
        >
            <div
                class="o_boardkit_dashboard_card_header d-flex align-items-center gap-2 px-3 pt-2"
                t-att-class="props.editable ? 'o_grab' : ''"
                t-on-pointerdown="(ev) => props.editable and props.onDragStart(ev)"
            >
                <span
                    class="o_boardkit_dashboard_card_title text-truncate fw-bold"
                    t-att-title="config.description || config.name"
                    t-esc="config.name"
                />
                <span class="ms-auto" />
                <i
                    t-if="props.editable"
                    class="fa fa-arrows o_boardkit_dashboard_drag_icon"
                    role="img"
                    aria-label="Move"
                />
                <Dropdown t-if="!props.editable and !props.preview">
                    <button
                        class="btn btn-sm btn-link p-0 o_boardkit_dashboard_card_menu"
                    >
                        <i class="fa fa-ellipsis-v" role="img" aria-label="Item menu" />
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem
                            t-if="props.isManager"
                            onSelected="props.onEdit"
                        >Edit</DropdownItem>
                        <DropdownItem
                            t-if="props.isManager"
                            onSelected="props.onDuplicate"
                        >Duplicate</DropdownItem>
                        <DropdownItem
                            onSelected="() => props.onExport('csv')"
                        >Export CSV</DropdownItem>
                        <DropdownItem
                            onSelected="() => props.onExport('xlsx')"
                        >Export XLSX</DropdownItem>
                        <DropdownItem
                            t-if="props.isManager"
                            onSelected="props.onDelete"
                        >Delete</DropdownItem>
                    </t>
                </Dropdown>
            </div>
            <div
                t-if="isDrilled"
                class="o_boardkit_dashboard_drill_breadcrumb d-flex align-items-center gap-1 px-3 small"
            >
                <button
                    class="btn btn-link btn-sm p-0"
                    title="Back"
                    t-on-click="() => this.goToDrillLevel(state.drillStack.length - 2)"
                >
                    <i class="fa fa-arrow-left" role="img" aria-label="Back" />
                </button>
                <button
                    class="btn btn-link btn-sm p-0 text-truncate"
                    t-on-click="() => this.goToDrillLevel(-1)"
                >
                    <t t-esc="config.name" />
                </button>
                <t t-foreach="state.drillStack" t-as="entry" t-key="entry_index">
                    <span class="text-muted">/</span>
                    <button
                        t-if="!entry_last"
                        class="btn btn-link btn-sm p-0 text-truncate"
                        t-on-click="() => this.goToDrillLevel(entry_index)"
                    >
                        <t t-esc="entry.label" />
                    </button>
                    <span t-else="" class="text-truncate fw-bold" t-esc="entry.label" />
                </t>
            </div>
            <div
                class="o_boardkit_dashboard_card_body d-flex flex-column flex-grow-1 px-3 pb-2 overflow-hidden"
            >
                <!-- Loading -->
                <div
                    t-if="state.drilling or !displayData"
                    class="d-flex h-100 align-items-center justify-content-center"
                >
                    <i
                        class="fa fa-circle-o-notch fa-spin fa-2x text-muted"
                        role="img"
                        aria-label="Loading"
                    />
                </div>
                <!-- Error -->
                <div
                    t-elif="displayData.error"
                    class="d-flex h-100 align-items-center justify-content-center text-center text-muted small"
                    t-att-title="displayData.error"
                >
                    <div>
                        <i
                            class="fa fa-exclamation-triangle fa-2x mb-2"
                            role="img"
                            aria-label="Error"
                        />
                        <div
                            t-esc="displayData.error"
                            class="o_boardkit_dashboard_error_text"
                        />
                    </div>
                </div>
                <!-- Drilled chart view (overrides the root tile/kpi/chart) -->
                <ChartRenderer
                    t-elif="isDrilled"
                    config="displayConfig"
                    data="displayData"
                    currency="props.currency"
                    onSectionClicked.bind="onChartSectionClicked"
                />
                <!-- Tile -->
                <div
                    t-elif="config.type === 'tile'"
                    class="d-flex h-100 align-items-center gap-3"
                    t-att-class="config.show_records and !props.editable ? 'cursor-pointer' : ''"
                    t-on-click="onBodyClicked"
                >
                    <span
                        class="o_boardkit_dashboard_tile_icon d-flex align-items-center justify-content-center rounded"
                        t-att-style="tileIconStyle"
                    >
                        <i
                            t-att-class="'fa fa-2x ' + (config.icon || 'fa-bar-chart')"
                            role="img"
                            aria-label="Tile icon"
                        />
                    </span>
                    <div class="overflow-hidden">
                        <div class="d-flex align-items-baseline gap-2 flex-wrap">
                            <div
                                class="o_boardkit_dashboard_big_value"
                                t-esc="formattedValue"
                            />
                            <span
                                t-if="previousDelta"
                                class="badge"
                                t-att-class="previousDelta.positive ? 'text-bg-success' : 'text-bg-danger'"
                            >
                                <i
                                    t-att-class="'fa ' + (previousDelta.positive ? 'fa-arrow-up' : 'fa-arrow-down')"
                                    role="img"
                                    aria-label="Trend"
                                />
                                <t t-esc="previousDelta.value" />
                            </span>
                        </div>
                        <div
                            t-if="aggregationLabel"
                            class="text-truncate opacity-75"
                            t-esc="aggregationLabel"
                        />
                    </div>
                </div>
                <!-- KPI -->
                <div
                    t-elif="config.type === 'kpi'"
                    class="d-flex flex-column h-100 justify-content-center"
                    t-att-class="config.show_records and !props.editable ? 'cursor-pointer' : ''"
                    t-on-click="onBodyClicked"
                >
                    <div class="d-flex align-items-baseline gap-2 flex-wrap">
                        <span
                            class="o_boardkit_dashboard_big_value"
                            t-esc="formattedValue"
                        />
                        <span
                            t-if="previousDelta"
                            class="badge"
                            t-att-class="previousDelta.positive ? 'text-bg-success' : 'text-bg-danger'"
                        >
                            <i
                                t-att-class="'fa ' + (previousDelta.positive ? 'fa-arrow-up' : 'fa-arrow-down')"
                                role="img"
                                aria-label="Trend"
                            />
                            <t t-esc="previousDelta.value" />
                        </span>
                    </div>
                    <t
                        t-if="config.kpi.mode === 'target' and data.target !== undefined"
                    >
                        <div class="progress mt-2" t-att-style="kpiProgressTrackStyle">
                            <div
                                class="progress-bar"
                                role="progressbar"
                                t-att-style="kpiProgressStyle"
                            />
                        </div>
                        <div
                            class="d-flex justify-content-between small opacity-75 mt-1"
                        >
                            <span>
                                <t t-esc="Math.round(targetProgress || 0)" />%
                            </span>
                            <span>Target: <t t-esc="formattedTarget" /></span>
                        </div>
                    </t>
                    <t
                        t-if="config.kpi.mode === 'comparison' and data.value_2 !== undefined"
                    >
                        <div
                            t-if="config.kpi.display === 'value'"
                            class="small opacity-75 mt-1"
                        >
                            vs <span class="fw-bold" t-esc="formattedValue2" />
                        </div>
                        <div t-else="" class="small opacity-75 mt-1">
                            <span class="fw-bold" t-esc="kpiComparison" />
                            (<t t-esc="formattedValue" /> / <t
                            t-esc="formattedValue2"
                        />)
                        </div>
                    </t>
                </div>
                <!-- List -->
                <ListCard
                    t-elif="config.type === 'list'"
                    config="config"
                    data="data"
                    onOpenRecord="(resId) => props.onOpenRecord(resId)"
                    onOpenGroup="(domain) => props.onDrill(domain, config.name)"
                    onPageChange="(params) => props.onPageChange(params)"
                />
                <!-- Bank overview -->
                <div
                    t-elif="config.type === 'bank_overview'"
                    class="o_boardkit_bank_overview h-100 d-flex flex-column"
                >
                    <t t-if="!displayData.journals.length">
                        <div
                            class="d-flex h-100 align-items-center justify-content-center text-center text-muted"
                        >
                            <div>
                                <i
                                    class="fa fa-university fa-2x mb-2"
                                    role="img"
                                    aria-label="Banco"
                                />
                                <div>No hay diarios bancarios disponibles.</div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div
                            class="o_boardkit_bank_overview_toolbar d-flex align-items-center gap-2 mb-3"
                        >
                            <label
                                class="visually-hidden"
                                t-att-for="'bank-journal-' + config.id"
                            >Seleccionar banco</label>
                            <select
                                t-att-id="'bank-journal-' + config.id"
                                class="form-select o_boardkit_bank_journal_select"
                                t-att-value="displayData.selected_journal_id"
                                t-on-change="onBankJournalChange"
                                t-att-disabled="state.bankLoading"
                            >
                                <option
                                    t-foreach="displayData.journals"
                                    t-as="journal"
                                    t-key="journal.id"
                                    t-att-value="journal.id"
                                    t-esc="journal.name"
                                />
                            </select>
                            <span class="small text-muted text-nowrap">
                                <t t-if="state.bankLoading">Actualizando…</t>
                                <t t-else="">Actualizado <t
                                    t-esc="formatBankTime(displayData.refreshed_at)"
                                /></t>
                            </span>
                        </div>
                        <div
                            class="o_boardkit_bank_overview_content row g-3 flex-grow-1 overflow-hidden"
                        >
                            <section
                                class="o_boardkit_bank_summary col-12 col-lg-4 d-flex flex-column"
                            >
                                <div class="small text-muted">Saldo contable</div>
                                <div class="o_boardkit_bank_balance">
                                    <t
                                        t-esc="formatBankAmount(displayData.selected_journal.balance, displayData.selected_journal.currency)"
                                    />
                                </div>
                                <div class="o_boardkit_bank_counts mt-3">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span>Por conciliar</span>
                                        <strong
                                            t-esc="displayData.selected_journal.number_to_reconcile"
                                        />
                                    </div>
                                    <div class="d-flex justify-content-between gap-2">
                                        <span>Por revisar</span>
                                        <strong
                                            t-esc="displayData.selected_journal.number_to_check"
                                        />
                                    </div>
                                </div>
                                <div
                                    class="o_boardkit_bank_actions d-flex flex-wrap gap-2 mt-auto pt-3"
                                >
                                    <button
                                        class="btn btn-primary"
                                        t-on-click="() => onBankAction('transactions')"
                                    >
                                        Transacciones
                                    </button>
                                    <button
                                        t-if="displayData.can_reconcile"
                                        class="btn btn-secondary"
                                        t-on-click="() => onBankAction('reconcile')"
                                    >
                                        Conciliar
                                    </button>
                                </div>
                            </section>
                            <section
                                class="o_boardkit_bank_transactions col-12 col-lg-8 d-flex flex-column overflow-hidden"
                            >
                                <h3 class="h6 mb-2">Transacciones recientes</h3>
                                <div
                                    t-if="!displayData.transactions.length"
                                    class="o_boardkit_bank_empty_transactions text-muted d-flex flex-grow-1 align-items-center justify-content-center text-center"
                                >
                                    No hay transacciones recientes para este diario.
                                </div>
                                <div t-else="" class="table-responsive flex-grow-1">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col">Fecha</th>
                                                <th scope="col">Descripción</th>
                                                <th
                                                    scope="col"
                                                    class="text-end"
                                                >Monto</th>
                                                <th scope="col">Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr
                                                t-foreach="displayData.transactions"
                                                t-as="transaction"
                                                t-key="transaction.id"
                                            >
                                                <td
                                                    class="text-nowrap"
                                                    t-esc="formatBankDate(transaction.date)"
                                                />
                                                <td
                                                    class="o_boardkit_bank_transaction_label"
                                                    t-esc="transaction.label or 'Sin descripción'"
                                                />
                                                <td
                                                    class="text-end text-nowrap"
                                                    t-esc="formatBankAmount(transaction.amount, transaction.currency)"
                                                />
                                                <td class="text-nowrap">
                                                    <span
                                                        class="badge"
                                                        t-att-class="bankStatusClass(transaction.status)"
                                                        t-esc="bankStatusLabel(transaction.status)"
                                                    />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        </div>
                    </t>
                </div>
                <!-- Charts -->
                <ChartRenderer
                    t-else=""
                    config="displayConfig"
                    data="displayData"
                    currency="props.currency"
                    onSectionClicked.bind="onChartSectionClicked"
                />
            </div>
            <div
                t-if="displayData and displayData.truncated"
                class="px-3 pb-2 small text-muted text-truncate"
                title="Too many records to plot them all. Narrow the filters or the item domain to see the full picture."
            >
                <i class="fa fa-info-circle me-1" role="img" aria-label="Notice" />
                Partial data
            </div>
            <div
                t-if="props.editable"
                class="o_boardkit_dashboard_resize_handle"
                role="button"
                aria-label="Resize"
                t-on-pointerdown="(ev) => props.onResizeStart(ev)"
            />
        </div>
    </t>
</templates>
